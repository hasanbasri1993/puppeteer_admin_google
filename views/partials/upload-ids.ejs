<div class="space-y-6">
    <div class="border-b border-gray-200">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">Upload Data Siswa</h2>
        <p class="text-gray-600 text-sm sm:text-base">Ganti data <code>ids.json</code> dengan file baru</p>
    </div>

    <div class="rounded-md bg-blue-50 border border-blue-200 p-4">
        <p class="text-sm text-blue-800">
            Gunakan Google Sheet berikut untuk menyusun/generate <code>ids.json</code> sebelum diunggah:
        </p>
        <a href="https://docs.google.com/spreadsheets/d/1ondYs7OO2RF-2B65QoBa2Qt0srQn4CyFi0tnvugUxXs/edit?gid=0#gid=0"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-flex items-center mt-2 text-sm font-medium text-primary hover:text-secondary underline">
            Buka Google Sheet Data Siswa
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
        </a>
    </div>

    <div class="rounded-md bg-yellow-50 border border-yellow-200 p-4">
        <p class="text-sm text-yellow-800">
            <strong>Perhatian:</strong> Mengunggah file baru akan <strong>menggantikan seluruh data siswa yang ada saat ini</strong>.
            Pastikan file berupa JSON array berisi objek dengan field <code>ID_GOOGLE</code>, <code>NIS</code>, <code>KELAS</code>, dan <code>NAMA</code>.
        </p>
    </div>

    <div class="space-y-4">
        <div>
            <label for="ids-file-input" class="block text-sm font-medium text-gray-700 mb-2">
                File ids.json
            </label>
            <input type="file"
                   id="ids-file-input"
                   accept="application/json,.json"
                   class="w-full text-sm text-gray-700 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-primary file:text-white file:text-sm file:font-medium hover:file:bg-secondary">
        </div>

        <button onclick="uploadIds()"
                class="w-full bg-primary hover:bg-secondary text-white font-medium py-2 px-4 rounded-md transition duration-150 ease-in-out">
            Upload &amp; Ganti Data
        </button>
    </div>
</div>

<script>
    async function uploadIds() {
        const fileInput = document.getElementById('ids-file-input');
        const file = fileInput.files[0];

        if (!file) {
            showAlert('Pilih file ids.json terlebih dahulu', 'warning');
            return;
        }

        if (!confirm('Data siswa yang ada saat ini akan digantikan sepenuhnya. Lanjutkan?')) {
            return;
        }

        const formData = new FormData();
        formData.append('file', file);

        showLoading();
        try {
            const response = await fetch('/api/admin/upload-ids', {
                method: 'POST',
                body: formData
            });
            const result = await response.json();

            if (result.success) {
                showAlert(result.message || 'Data berhasil diperbarui', 'success');
                fileInput.value = '';
            } else {
                showAlert(result.error || 'Gagal mengunggah data', 'error');
            }
        } catch (error) {
            console.error('Error uploading ids.json:', error);
            showAlert('Gagal mengunggah data', 'error');
        } finally {
            hideLoading();
        }
    }
</script>
