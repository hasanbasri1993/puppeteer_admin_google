<div class="space-y-6">
    <!-- Section Header -->
    <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xl sm:text-2xl font-heading font-bold text-white tracking-tight flex items-center space-x-2">
            <span class="text-cyan-400">Turn Off Challenge</span>
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
            Nonaktifkan sementara (10 menit) tantangan keamanan login untuk akun siswa/santri.
        </p>
    </div>

    <!-- Tab Navigation -->
    <div class="border-b border-slate-800">
        <nav class="-mb-px flex space-x-6">
            <button onclick="switchTab('batch-nis')"
                    id="tab-batch-nis"
                    class="tab-button py-2.5 px-2 border-b-2 font-semibold text-sm border-cyan-400 text-cyan-400 transition flex items-center space-x-2">
                <span>Batch NIS</span>
                <span id="batch-count-badge" class="px-2 py-0.5 text-[10px] font-mono bg-cyan-500/10 text-cyan-300 rounded-full border border-cyan-500/20">0</span>
            </button>
            <% if (typeof canResetPassword !== 'undefined' && canResetPassword) { %>
                <button onclick="switchTab('per-kelas')"
                        id="tab-per-kelas"
                        class="tab-button py-2.5 px-2 border-b-2 font-semibold text-sm border-transparent text-slate-400 hover:text-slate-200 transition">
                    Per Kelas
                </button>
            <% } %>
        </nav>
    </div>

    <!-- Tab Content Container -->
    <div class="mt-6">
        <!-- Tab Batch NIS -->
        <div id="content-batch-nis" class="tab-content space-y-4">
            <div>
                <div class="flex justify-between items-center mb-2">
                    <label for="batch-nis-input" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
                        Input NIS (Satu per baris)
                    </label>
                    <span class="text-[11px] font-mono text-slate-500">Contoh: 234054</span>
                </div>
                <textarea id="batch-nis-input"
                          rows="7"
                          oninput="updateNisCount()"
                          class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl font-mono text-sm text-cyan-300 placeholder-slate-600 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition"
                          placeholder="234054&#10;234035&#10;234060"></textarea>
            </div>

            <button onclick="processBatchNIS()"
                    class="w-full bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-semibold py-3 px-4 rounded-xl shadow-lg shadow-cyan-500/20 transition duration-150 ease-in-out flex items-center justify-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Mulai Proses Turn Off</span>
            </button>
        </div>

        <% if (typeof canResetPassword !== 'undefined' && canResetPassword) { %>
            <!-- Tab Per Kelas -->
            <div id="content-per-kelas" class="tab-content hidden space-y-4">
                <div>
                    <label for="kelas-select" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                        Pilih Kelas
                    </label>
                    <select id="kelas-select" 
                            class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl text-sm text-slate-200 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition">
                        <option value="">-- Pilih Kelas Santri --</option>
                    </select>
                </div>

                <div>
                    <label for="nis-list" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                        Daftar NIS Terkait
                    </label>
                    <textarea id="nis-list" 
                              rows="6" 
                              readonly
                              class="w-full px-4 py-3 bg-slate-950/80 border border-slate-800 rounded-xl font-mono text-sm text-slate-400 focus:outline-none cursor-not-allowed"
                              placeholder="Pilih kelas terlebih dahulu..."></textarea>
                </div>

                <button onclick="processPerKelas()" 
                        class="w-full bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-semibold py-3 px-4 rounded-xl shadow-lg shadow-cyan-500/20 transition duration-150 ease-in-out flex items-center justify-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                    </svg>
                    <span>Mulai Proses Per Kelas</span>
                </button>
            </div>
        <% } %>
    </div>
</div>

<script src="https://js.pusher.com/8.4.0/pusher.min.js"></script>
<script>
    // Initialize Pusher Subscription
    const pusherKey = '<%= pusherId %>';
    if (pusherKey && typeof Pusher !== 'undefined') {
        const pusher = new Pusher(pusherKey, { cluster: 'ap1' });
        const channel = pusher.subscribe('turn_off');
        
        channel.bind('status-update', function(data) {
            console.log('Pusher update:', data);
            const isError = data.message && (data.message.toLowerCase().includes('failed') || data.message.toLowerCase().includes('error') || data.message.toLowerCase().includes('gagal') || data.message.toLowerCase().includes('relogin'));
            const msgType = isError ? 'error' : 'success';
            
            // Show toast notification
            showAlert(`[${data.id}] ${data.message}`, msgType);
            
            // Stream log to Signature Console HUD in dashboard
            if (typeof appendConsoleLog === 'function') {
                appendConsoleLog(`[${data.id}] ${data.message}`, msgType);
            }
        });
    }

    function updateNisCount() {
        const val = document.getElementById('batch-nis-input').value;
        const count = val.split('\n').filter(s => s.trim().length > 0).length;
        const badge = document.getElementById('batch-count-badge');
        if (badge) badge.textContent = count;
    }

    function switchTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
        document.querySelectorAll('.tab-button').forEach(button => {
            button.classList.remove('border-cyan-400', 'text-cyan-400');
            button.classList.add('border-transparent', 'text-slate-400');
        });
        
        document.getElementById(`content-${tabName}`).classList.remove('hidden');
        const activeButton = document.getElementById(`tab-${tabName}`);
        if (activeButton) {
            activeButton.classList.add('border-cyan-400', 'text-cyan-400');
            activeButton.classList.remove('border-transparent', 'text-slate-400');
        }
        
        if (tabName === 'per-kelas') loadClasses();
    }
    
    async function loadClasses() {
        try {
            const response = await fetch('/pages/get-classes');
            const classes = await response.json();
            
            const select = document.getElementById('kelas-select');
            select.innerHTML = '<option value="">-- Pilih Kelas Santri --</option>';
            
            classes.forEach(kelas => {
                const option = document.createElement('option');
                option.value = kelas;
                option.textContent = `Kelas ${kelas}`;
                select.appendChild(option);
            });
            
            select.onchange = function() {
                if (this.value) loadNISForClass(this.value);
                else document.getElementById('nis-list').value = '';
            };
        } catch (error) {
            console.error('Error loading classes:', error);
            showAlert('Gagal memuat daftar kelas', 'error');
        }
    }
    
    async function loadNISForClass(kelas) {
        try {
            const response = await fetch(`/pages/get-nis-by-class?kelas=${encodeURIComponent(kelas)}`);
            const data = await response.json();
            document.getElementById('nis-list').value = data.nis_list.join('\n');
        } catch (error) {
            console.error('Error loading NIS:', error);
            showAlert('Gagal memuat daftar NIS', 'error');
        }
    }
    
    async function processPerKelas() {
        const kelas = document.getElementById('kelas-select').value;
        const nisList = document.getElementById('nis-list').value;
        if (!kelas || !nisList) {
            showAlert('Pilih kelas dan pastikan daftar NIS tersedia', 'warning');
            return;
        }
        const nisArray = nisList.split('\n').filter(nis => nis.trim());
        await processTurnOff(nisArray);
    }
    
    async function processBatchNIS() {
        const nisInput = document.getElementById('batch-nis-input').value;
        if (!nisInput.trim()) {
            showAlert('Masukkan minimal satu NIS santri', 'warning');
            return;
        }
        const nisArray = nisInput.split('\n').filter(nis => nis.trim());
        await processTurnOff(nisArray);
    }
    
    async function processTurnOff(nisArray) {
        showLoading();
        if (typeof appendConsoleLog === 'function') {
            appendConsoleLog(`Mengirim batch ${nisArray.length} NIS ke server...`, 'info');
        }
        
        try {
            const response = await fetch('/api/turn_off', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ nis: nisArray })
            });
            
            const result = await response.json();
            
            if (result.success) {
                showAlert(`Selesai! Sukses: ${result.summary.successful}, Gagal: ${result.summary.failed} dari ${result.summary.total} NIS`, 'success');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`Batch Selesai! Total: ${result.summary.total}, Sukses: ${result.summary.successful}, Gagal: ${result.summary.failed}`, 'success');
                }
            } else {
                showAlert(result.message || result.error || 'Terjadi kesalahan', 'error');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`Gagal memproses batch: ${result.message || result.error}`, 'error');
                }
            }
        } catch (error) {
            console.error('Error processing turn off:', error);
            showAlert('Gagal memproses permintaan', 'error');
            if (typeof appendConsoleLog === 'function') {
                appendConsoleLog(`Server/Network Error: ${error.message}`, 'error');
            }
        } finally {
            hideLoading();
        }
    }
</script>

