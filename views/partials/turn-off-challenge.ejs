<div class="space-y-6">
    <!-- Section Header -->
    <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xl sm:text-2xl font-heading font-bold text-white tracking-tight flex items-center space-x-2">
            <span class="text-cyan-400">Turn Off Challenge</span>
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
            Nonaktifkan sementara (10 menit) tantangan keamanan login untuk akun siswa/santri.
        </p>
    </div>

    <!-- Tab Navigation -->
    <div class="border-b border-slate-800">
        <nav class="-mb-px flex space-x-6">
            <button onclick="switchTab('batch-nis')"
                    id="tab-batch-nis"
                    class="tab-button py-2.5 px-2 border-b-2 font-semibold text-sm border-cyan-400 text-cyan-400 transition flex items-center space-x-2">
                <span>Batch NIS</span>
                <span id="batch-count-badge" class="px-2 py-0.5 text-[10px] font-mono bg-cyan-500/10 text-cyan-300 rounded-full border border-cyan-500/20">0</span>
            </button>
            <% if (typeof canResetPassword !== 'undefined' && canResetPassword) { %>
                <button onclick="switchTab('per-kelas')"
                        id="tab-per-kelas"
                        class="tab-button py-2.5 px-2 border-b-2 font-semibold text-sm border-transparent text-slate-400 hover:text-slate-200 transition">
                    Per Kelas
                </button>
            <% } %>
        </nav>
    </div>

    <!-- Tab Content Container -->
    <div class="mt-6">
        <!-- Tab Batch NIS -->
        <div id="content-batch-nis" class="tab-content space-y-4">
            <div>
                <div class="flex justify-between items-center mb-2">
                    <label for="batch-nis-input" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
                        Input NIS (Satu per baris)
                    </label>
                    <span class="text-[11px] font-mono text-slate-500">Contoh: 234054</span>
                </div>
                <textarea id="batch-nis-input"
                          rows="7"
                          oninput="updateNisCount()"
                          class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl font-mono text-sm text-cyan-300 placeholder-slate-600 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition"
                          placeholder="234054&#10;234035&#10;234060"></textarea>
            </div>

            <button onclick="processBatchNIS()"
                    class="light-primary-action w-full bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-semibold py-3 px-4 rounded-xl shadow-lg shadow-cyan-500/20 transition duration-150 ease-in-out flex items-center justify-center space-x-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>Mulai Proses Turn Off</span>
            </button>
        </div>

        <% if (typeof canResetPassword !== 'undefined' && canResetPassword) { %>
            <!-- Tab Per Kelas -->
            <div id="content-per-kelas" class="tab-content hidden space-y-4">
                <div>
                    <label for="kelas-select" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                        Pilih Kelas
                    </label>
                    <select id="kelas-select" 
                            class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl text-sm text-slate-200 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition">
                        <option value="">-- Pilih Kelas Santri --</option>
                    </select>
                </div>

                <div>
                    <label for="nis-list" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                        Daftar NIS Terkait
                    </label>
                    <textarea id="nis-list" 
                              rows="6" 
                              readonly
                              class="w-full px-4 py-3 bg-slate-950/80 border border-slate-800 rounded-xl font-mono text-sm text-slate-400 focus:outline-none cursor-not-allowed"
                              placeholder="Pilih kelas terlebih dahulu..."></textarea>
                </div>

                <button onclick="processPerKelas()" 
                        class="light-primary-action w-full bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white font-semibold py-3 px-4 rounded-xl shadow-lg shadow-cyan-500/20 transition duration-150 ease-in-out flex items-center justify-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                    </svg>
                    <span>Mulai Proses Per Kelas</span>
                </button>
            </div>
        <% } %>
    </div>
</div>

<div id="turn-off-progress-modal" class="hidden fixed inset-0 z-50 p-4 sm:p-8 bg-slate-950/80 backdrop-blur-sm overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="turn-off-progress-title">
    <div class="min-h-full flex items-center justify-center">
        <section class="w-full max-w-2xl rounded-2xl border border-cyan-500/20 bg-slate-900 shadow-2xl shadow-cyan-950/40 overflow-hidden">
            <div class="px-5 sm:px-6 py-4 border-b border-slate-800 flex items-start justify-between gap-4">
                <div>
                    <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-cyan-400">Proses aktif</p>
                    <h3 id="turn-off-progress-title" class="mt-1 text-lg font-heading font-bold text-white">Menonaktifkan login challenge</h3>
                </div>
                <span id="turn-off-progress-count" class="px-2.5 py-1 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-xs font-mono text-cyan-300">0 / 0</span>
            </div>
            <div class="p-5 sm:p-6 space-y-4">
                <div>
                    <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
                        <div id="turn-off-progress-bar" class="h-full w-0 bg-gradient-to-r from-cyan-400 to-indigo-500 transition-all duration-300"></div>
                    </div>
                    <div class="mt-2 flex justify-between text-xs">
                        <span id="turn-off-progress-summary" class="text-slate-400">Menghubungkan ke Google Admin...</span>
                        <span id="turn-off-progress-percent" class="font-mono text-cyan-300">0%</span>
                    </div>
                </div>
                <div id="turn-off-progress-list" class="max-h-[50vh] overflow-y-auto rounded-xl border border-slate-800 divide-y divide-slate-800 bg-slate-950/40"></div>
                <div id="turn-off-progress-footer" class="hidden pt-1 flex justify-end">
                    <button onclick="closeTurnOffProgressModal()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-slate-200 transition">Tutup</button>
                </div>
            </div>
        </section>
    </div>
</div>

<script src="https://js.pusher.com/8.4.0/pusher.min.js"></script>
<script>
    const pusherKey = '<%= pusherId %>';
    const pusher = pusherKey && typeof Pusher !== 'undefined' ? new Pusher(pusherKey, { cluster: 'ap1' }) : null;
    let activeProgressChannel = null;
    let activeProgressRequestId = null;
    let activeProgressState = null;

    function updateNisCount() {
        const val = document.getElementById('batch-nis-input').value;
        const count = val.split('\n').filter(s => s.trim().length > 0).length;
        const badge = document.getElementById('batch-count-badge');
        if (badge) badge.textContent = count;
    }

    function switchTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));
        document.querySelectorAll('.tab-button').forEach(button => {
            button.classList.remove('border-cyan-400', 'text-cyan-400');
            button.classList.add('border-transparent', 'text-slate-400');
        });
        
        document.getElementById(`content-${tabName}`).classList.remove('hidden');
        const activeButton = document.getElementById(`tab-${tabName}`);
        if (activeButton) {
            activeButton.classList.add('border-cyan-400', 'text-cyan-400');
            activeButton.classList.remove('border-transparent', 'text-slate-400');
        }
        
        if (tabName === 'per-kelas') loadClasses();
    }
    
    async function loadClasses() {
        try {
            const response = await fetch('/pages/get-classes');
            const classes = await response.json();
            
            const select = document.getElementById('kelas-select');
            select.innerHTML = '<option value="">-- Pilih Kelas Santri --</option>';
            
            classes.forEach(kelas => {
                const option = document.createElement('option');
                option.value = kelas;
                option.textContent = `Kelas ${kelas}`;
                select.appendChild(option);
            });
            
            select.onchange = function() {
                if (this.value) loadNISForClass(this.value);
                else document.getElementById('nis-list').value = '';
            };
        } catch (error) {
            console.error('Error loading classes:', error);
            showAlert('Gagal memuat daftar kelas', 'error');
        }
    }
    
    async function loadNISForClass(kelas) {
        try {
            const response = await fetch(`/pages/get-nis-by-class?kelas=${encodeURIComponent(kelas)}`);
            const data = await response.json();
            document.getElementById('nis-list').value = data.nis_list.join('\n');
        } catch (error) {
            console.error('Error loading NIS:', error);
            showAlert('Gagal memuat daftar NIS', 'error');
        }
    }
    
    async function processPerKelas() {
        const kelas = document.getElementById('kelas-select').value;
        const nisList = document.getElementById('nis-list').value;
        if (!kelas || !nisList) {
            showAlert('Pilih kelas dan pastikan daftar NIS tersedia', 'warning');
            return;
        }
        const nisArray = nisList.split('\n').filter(nis => nis.trim());
        await processTurnOff(nisArray);
    }
    
    async function processBatchNIS() {
        const nisInput = document.getElementById('batch-nis-input').value;
        if (!nisInput.trim()) {
            showAlert('Masukkan minimal satu NIS santri', 'warning');
            return;
        }
        const nisArray = nisInput.split('\n').filter(nis => nis.trim());
        await processTurnOff(nisArray);
    }
    
    async function processTurnOff(nisArray) {
        const requestId = createTurnOffRequestId();
        activeProgressRequestId = requestId;
        activeProgressState = {total: nisArray.length, completed: 0, success: 0, failed: 0, completedNis: new Set(), closeTimer: null};
        openTurnOffProgressModal(nisArray);

        if (!pusher) {
            finishTurnOffProgress('Pusher tidak tersedia; progres real-time tidak dapat ditampilkan.', true);
            return;
        }

        activeProgressChannel = pusher.subscribe(`turn_off_${requestId}`);
        activeProgressChannel.bind('status-update', (data) => {
            if (data.requestId !== activeProgressRequestId) return;
            updateTurnOffProgress(data);
        });

        if (typeof appendConsoleLog === 'function') {
            appendConsoleLog(`Mengirim batch ${nisArray.length} NIS ke server...`, 'info');
        }
        
        try {
            const response = await fetch('/api/turn_off', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({nis: nisArray, requestId})
            });
            
            const result = await response.json();
            
            if (result.success) {
                applyFinalTurnOffResults(result.results || []);
                const hasFailure = result.summary.failed > 0;
                finishTurnOffProgress(`Selesai. Sukses: ${result.summary.successful}, gagal: ${result.summary.failed} dari ${result.summary.total} NIS.`, hasFailure);
                showAlert(`Selesai! Sukses: ${result.summary.successful}, Gagal: ${result.summary.failed} dari ${result.summary.total} NIS`, hasFailure ? 'warning' : 'success');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`Batch Selesai! Total: ${result.summary.total}, Sukses: ${result.summary.successful}, Gagal: ${result.summary.failed}`, 'success');
                }
            } else {
                finishTurnOffProgress(result.message || result.error || 'Terjadi kesalahan', true);
                showAlert(result.message || result.error || 'Terjadi kesalahan', 'error');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`Gagal memproses batch: ${result.message || result.error}`, 'error');
                }
            }
        } catch (error) {
            finishTurnOffProgress(`Server/Network Error: ${error.message}`, true);
            console.error('Error processing turn off:', error);
            showAlert('Gagal memproses permintaan', 'error');
            if (typeof appendConsoleLog === 'function') {
                appendConsoleLog(`Server/Network Error: ${error.message}`, 'error');
            }
        } finally {
            if (activeProgressChannel) {
                pusher.unsubscribe(activeProgressChannel.name);
                activeProgressChannel = null;
            }
        }
    }

    function createTurnOffRequestId() {
        if (window.crypto?.randomUUID) return window.crypto.randomUUID().replace(/-/g, '');
        return `${Date.now()}${Math.random().toString(36).slice(2)}`;
    }

    function openTurnOffProgressModal(nisArray) {
        const modal = document.getElementById('turn-off-progress-modal');
        const list = document.getElementById('turn-off-progress-list');
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        document.getElementById('turn-off-progress-count').textContent = `0 / ${nisArray.length}`;
        document.getElementById('turn-off-progress-bar').style.width = '0%';
        document.getElementById('turn-off-progress-percent').textContent = '0%';
        document.getElementById('turn-off-progress-summary').textContent = 'Menghubungkan ke Google Admin...';
        document.getElementById('turn-off-progress-footer').classList.add('hidden');
        list.innerHTML = nisArray.map(nis => `<div id="turn-off-row-${CSS.escape(String(nis))}" class="px-4 py-3 flex items-center justify-between gap-3 text-xs"><span class="font-mono text-slate-300">${escapeTurnOffHtml(nis)}</span><span class="text-slate-500">Menunggu</span></div>`).join('');
    }

    function renderTurnOffStudents(students) {
        const list = document.getElementById('turn-off-progress-list');
        list.innerHTML = students.map(student => `
            <div id="turn-off-row-${CSS.escape(String(student.nis))}" class="px-4 py-3 flex items-center justify-between gap-3 text-xs">
                <div class="min-w-0">
                    <p class="font-semibold text-slate-200 truncate">${escapeTurnOffHtml(student.name || 'Data siswa')}</p>
                    <p class="mt-0.5 font-mono text-[11px] text-slate-500">NIS ${escapeTurnOffHtml(student.nis)}${student.className ? ` · Kelas ${escapeTurnOffHtml(student.className)}` : ''}</p>
                </div>
                <span class="shrink-0 text-slate-500">Menunggu</span>
            </div>`).join('');
    }

    function updateTurnOffProgress(data) {
        const state = activeProgressState;
        if (Array.isArray(data.students)) renderTurnOffStudents(data.students);
        const isUserResult = data.nis && !state.completedNis.has(String(data.nis));
        if (isUserResult) {
            state.completedNis.add(String(data.nis));
            state.completed++;
            state[data.status === 'success' ? 'success' : 'failed']++;
            const row = document.getElementById(`turn-off-row-${CSS.escape(String(data.nis))}`);
            if (row) {
                row.lastElementChild.textContent = data.status === 'success' ? 'Berhasil' : 'Gagal';
                row.lastElementChild.className = data.status === 'success' ? 'text-emerald-400 font-semibold' : 'text-rose-400 font-semibold';
            }
        }
        const percent = state.total ? Math.round((state.completed / state.total) * 100) : 0;
        document.getElementById('turn-off-progress-count').textContent = `${state.completed} / ${state.total}`;
        document.getElementById('turn-off-progress-bar').style.width = `${percent}%`;
        document.getElementById('turn-off-progress-percent').textContent = `${percent}%`;
        document.getElementById('turn-off-progress-summary').textContent = data.id === 'System' ? data.message : `${state.success} berhasil · ${state.failed} gagal`;
        if (data.id !== 'System' && typeof appendConsoleLog === 'function') appendConsoleLog(`[${data.id}] ${data.message}`, data.status === 'success' ? 'success' : 'error');
    }

    function finishTurnOffProgress(message, isError) {
        document.getElementById('turn-off-progress-summary').textContent = message;
        document.getElementById('turn-off-progress-summary').className = isError ? 'text-rose-400' : 'text-emerald-400';
        document.getElementById('turn-off-progress-footer').classList.remove('hidden');
        if (activeProgressState?.closeTimer) clearTimeout(activeProgressState.closeTimer);
        activeProgressState.closeTimer = setTimeout(closeTurnOffProgressModal, 3000);
    }

    function applyFinalTurnOffResults(results) {
        results.forEach(result => {
            const nis = result.nis || result.id?.NIS || result.id;
            if (!nis || typeof nis === 'object') return;
            const key = String(nis);
            const row = document.getElementById(`turn-off-row-${CSS.escape(key)}`);
            if (!row || activeProgressState.completedNis.has(key)) return;

            activeProgressState.completedNis.add(key);
            activeProgressState.completed++;
            activeProgressState[result.status === 'success' ? 'success' : 'failed']++;
            row.lastElementChild.textContent = result.status === 'success' ? 'Berhasil' : 'Gagal';
            row.lastElementChild.className = result.status === 'success' ? 'text-emerald-400 font-semibold' : 'text-rose-400 font-semibold';
        });

        const state = activeProgressState;
        const percent = state.total ? Math.round((state.completed / state.total) * 100) : 0;
        document.getElementById('turn-off-progress-count').textContent = `${state.completed} / ${state.total}`;
        document.getElementById('turn-off-progress-bar').style.width = `${percent}%`;
        document.getElementById('turn-off-progress-percent').textContent = `${percent}%`;
    }

    function closeTurnOffProgressModal() {
        if (activeProgressState?.closeTimer) clearTimeout(activeProgressState.closeTimer);
        document.getElementById('turn-off-progress-modal').classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    function escapeTurnOffHtml(value) {
        const element = document.createElement('div');
        element.textContent = value;
        return element.innerHTML;
    }
</script>

