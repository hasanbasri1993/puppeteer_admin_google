<div class="space-y-6">
    <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xl sm:text-2xl font-heading font-bold text-white tracking-tight flex items-center space-x-2">
            <span class="text-rose-400">Kelola Akses Admin</span>
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
            Tambah atau hapus email pengguna yang diizinkan mengakses fitur tingkat tinggi (Reset Password, Upload Data, Kelola Admin).
        </p>
    </div>

    <div class="space-y-6">
        <!-- Add Admin Input Group -->
        <div>
            <label for="new-admin-email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Tambah Admin Baru
            </label>
            <div class="flex flex-col sm:flex-row gap-3">
                <input type="email"
                       id="new-admin-email"
                       autocomplete="off"
                       class="flex-1 px-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl font-mono text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition"
                       placeholder="email@daarululuumlido.com">
                <button onclick="addAdmin()"
                        class="bg-gradient-to-r from-rose-500 to-indigo-600 hover:from-rose-400 hover:to-indigo-500 text-white font-semibold py-3 px-5 rounded-xl shadow-lg shadow-rose-500/20 transition duration-150 ease-in-out whitespace-nowrap flex items-center justify-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                    </svg>
                    <span>Tambah Admin</span>
                </button>
            </div>
        </div>

        <!-- Admin List -->
        <div>
            <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Daftar Admin Aktif</h3>
            <div class="bg-slate-900/90 border border-slate-800 rounded-xl overflow-hidden shadow-inner">
                <ul id="admin-list" class="divide-y divide-slate-800/80">
                    <li class="px-4 py-3.5 text-xs font-mono text-slate-500 animate-pulse">Memuat daftar admin...</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    async function loadAdminList() {
        const list = document.getElementById('admin-list');
        list.innerHTML = '<li class="px-4 py-3.5 text-xs font-mono text-slate-500 animate-pulse">Memuat daftar admin...</li>';

        try {
            const response = await fetch('/api/admin/list');
            const result = await response.json();

            if (!result.success || !Array.isArray(result.admins) || result.admins.length === 0) {
                list.innerHTML = '<li class="px-4 py-3.5 text-xs font-mono text-slate-500">Belum ada admin terdaftar</li>';
                return;
            }

            list.innerHTML = '';
            result.admins.forEach(email => {
                const li = document.createElement('li');
                li.className = 'px-4 py-3.5 flex items-center justify-between hover:bg-slate-800/40 transition';

                const div = document.createElement('div');
                div.className = 'flex items-center space-x-3';
                div.innerHTML = `
                    <div class="w-8 h-8 rounded-lg bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <span class="text-xs font-mono text-slate-200">${escapeHtml(email)}</span>
                `;

                const button = document.createElement('button');
                button.className = 'px-3 py-1 text-xs font-medium text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 rounded-lg transition border border-transparent hover:border-rose-500/20';
                button.textContent = 'Hapus';
                button.onclick = () => removeAdmin(email);

                li.appendChild(div);
                li.appendChild(button);
                list.appendChild(li);
            });
        } catch (error) {
            console.error('Error loading admin list:', error);
            list.innerHTML = '<li class="px-4 py-3.5 text-xs font-mono text-rose-400">Gagal memuat daftar admin</li>';
        }
    }

    async function addAdmin() {
        const input = document.getElementById('new-admin-email');
        const email = input.value.trim();

        if (!email) {
            showAlert('Masukkan email admin', 'warning');
            return;
        }

        showLoading();
        if (typeof appendConsoleLog === 'function') {
            appendConsoleLog(`Menambahkan admin baru: ${email}...`, 'info');
        }

        try {
            const response = await fetch('/api/admin/add', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email})
            });
            const result = await response.json();

            if (result.success) {
                showAlert('Admin berhasil ditambahkan', 'success');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`✅ Admin ${email} berhasil ditambahkan!`, 'success');
                }
                input.value = '';
                loadAdminList();
            } else {
                showAlert(result.error || 'Gagal menambahkan admin', 'error');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`❌ Gagal tambah admin ${email}: ${result.error}`, 'error');
                }
            }
        } catch (error) {
            console.error('Error adding admin:', error);
            showAlert('Gagal menambahkan admin', 'error');
        } finally {
            hideLoading();
        }
    }

    async function removeAdmin(email) {
        if (!confirm(`Hapus akses admin untuk ${email}?`)) {
            return;
        }

        showLoading();
        if (typeof appendConsoleLog === 'function') {
            appendConsoleLog(`Menghapus akses admin: ${email}...`, 'warn');
        }

        try {
            const response = await fetch('/api/admin/remove', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email})
            });
            const result = await response.json();

            if (result.success) {
                showAlert('Admin berhasil dihapus', 'success');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`✅ Admin ${email} berhasil dihapus!`, 'success');
                }
                loadAdminList();
            } else {
                showAlert(result.error || 'Gagal menghapus admin', 'error');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`❌ Gagal hapus admin ${email}: ${result.error}`, 'error');
                }
            }
        } catch (error) {
            console.error('Error removing admin:', error);
            showAlert('Gagal menghapus admin', 'error');
        } finally {
            hideLoading();
        }
    }

    loadAdminList();
</script>

