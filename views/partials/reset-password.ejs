<div class="space-y-6">
    <div class="border-b border-slate-800 pb-4">
        <h2 class="text-xl sm:text-2xl font-heading font-bold text-white tracking-tight flex items-center space-x-2">
            <span class="text-indigo-400">Reset Password Santri</span>
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
            Reset kata sandi akun Google Workspace siswa (@daarululuumlido.com) ke password default.
        </p>
    </div>

    <div class="space-y-4">
        <div>
            <label for="nis-input" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                NIS Santri
            </label>
            <div class="relative">
                <input type="text"
                       id="nis-input"
                       inputmode="numeric"
                       autocomplete="off"
                       class="w-full px-4 py-3 bg-slate-900/90 border border-slate-700/80 rounded-xl font-mono text-sm text-cyan-300 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
                       placeholder="Masukkan NIS (contoh: 234054)">
                <span class="absolute right-3 top-3 text-xs font-mono text-slate-500 pointer-events-none">@daarululuumlido.com</span>
            </div>
            <p class="mt-1.5 text-xs text-slate-500">Password baru default akan diset otomatis.</p>
        </div>

        <button onclick="processSantri()"
                class="w-full bg-gradient-to-r from-indigo-500 to-cyan-500 hover:from-indigo-400 hover:to-cyan-400 text-white font-semibold py-3 px-4 rounded-xl shadow-lg shadow-indigo-500/20 transition duration-150 ease-in-out flex items-center justify-center space-x-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
            </svg>
            <span>Reset Password Sekarang</span>
        </button>
    </div>
</div>

<script>
    async function processSantri() {
        const input = document.getElementById('nis-input');
        const nis = input.value.trim();

        if (!nis) {
            showAlert('Masukkan NIS santri', 'warning');
            return;
        }

        showLoading();
        if (typeof appendConsoleLog === 'function') {
            appendConsoleLog(`Memproses reset password untuk NIS ${nis}...`, 'info');
        }

        try {
            const response = await fetch('/api/reset_password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: `${nis}@daarululuumlido.com`, password: "Dulido@24061996" })
            });

            const result = await response.json();

            if (result.success) {
                showAlert(result.message || 'Password berhasil direset', 'success');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`✅ Password NIS ${nis} berhasil direset!`, 'success');
                }
                input.value = '';
            } else {
                showAlert(result.error || result.message || 'Terjadi kesalahan', 'error');
                if (typeof appendConsoleLog === 'function') {
                    appendConsoleLog(`❌ Gagal reset password NIS ${nis}: ${result.error || result.message}`, 'error');
                }
            }

        } catch (error) {
            console.error('Error processing santri reset:', error);
            showAlert('Gagal memproses permintaan', 'error');
            if (typeof appendConsoleLog === 'function') {
                appendConsoleLog(`Error koneksi: ${error.message}`, 'error');
            }
        } finally {
            hideLoading();
        }
    }
</script>

