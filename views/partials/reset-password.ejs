<div class="space-y-6">
    <div class="border-b border-gray-200 pb-4">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">Reset Password</h2>
        <p class="text-gray-600 text-sm sm:text-base">Reset password untuk siswa atau pengguna</p>
    </div>

    <div class="space-y-4">
        <div>
            <label for="nis-input" class="block text-sm font-medium text-gray-700 mb-2">
                NIS Santri
            </label>
            <input type="text"
                   id="nis-input"
                   inputmode="numeric"
                   autocomplete="off"
                   class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary"
                   placeholder="Masukkan NIS (tanpa domain)">
            <p class="mt-1 text-xs text-gray-500">Contoh: 234054</p>
        </div>

        <button onclick="processSantri()"
                class="w-full bg-primary hover:bg-secondary text-white font-medium py-2 px-4 rounded-md transition duration-150 ease-in-out">
            Reset Password
        </button>
    </div>
</div>

<script>
    async function processSantri() {
        const input = document.getElementById('nis-input');
        const nis = input.value.trim();
        const btn = document.querySelector('button');

        if (!nis) {
            showAlert('Masukkan NIS santri', 'warning');
            return;
        }

        showLoading();
        btn.disabled = true;
        btn.classList.add('opacity-60', 'cursor-not-allowed');

        try {
            const response = await fetch('/api/reset_password', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ email: `${nis}@daarululuumlido.com`, password: "Dulido@24061996" })
            });

            const result = await response.json();

            if (result.success) {
                showAlert(result.message || 'Password berhasil direset', 'success');
                input.value = '';
            } else {
                showAlert(result.error || result.message || 'Terjadi kesalahan', 'error');
            }

        } catch (error) {
            console.error('Error processing santri reset:', error);
            showAlert('Gagal memproses permintaan', 'error');
        } finally {
            hideLoading();
            btn.disabled = false;
            btn.classList.remove('opacity-60', 'cursor-not-allowed');
        }
    }
</script>
