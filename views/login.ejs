<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Dulido Admin Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        heading: ['"Outfit"', 'sans-serif'],
                    },
                    colors: {
                        darkBg: '#0B0F17',
                        surface: '#161E2E',
                        primary: '#06B6D4',
                        secondary: '#6366F1',
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #0B0F17; }
        .glass-card {
            background: rgba(22, 30, 46, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glow-effect {
            box-shadow: 0 0 50px -10px rgba(6, 182, 212, 0.25);
        }
    </style>
</head>
<body class="bg-darkBg text-slate-100 min-h-screen flex items-center justify-center relative overflow-hidden px-4">
    <!-- Ambient Radial Glows -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full relative z-10">
        <!-- Logo & Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-cyan-500 to-indigo-600 p-0.5 shadow-lg shadow-cyan-500/20 mb-4">
                <div class="w-full h-full bg-darkBg rounded-[14px] flex items-center justify-center">
                    <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                </div>
            </div>
            <h1 class="text-3xl font-heading font-extrabold text-white tracking-tight">
                Dulido Admin Console
            </h1>
            <p class="mt-2 text-sm text-slate-400">
                Portal Manajemen Keamanan &amp; Akun Google Admin
            </p>
        </div>
        
        <!-- Login Card -->
        <div class="glass-card glow-effect rounded-2xl p-8 shadow-2xl">
            <div class="text-center space-y-6">
                <div>
                    <h3 class="text-lg font-heading font-semibold text-white">
                        Otentikasi Pengguna
                    </h3>
                    <p class="text-xs text-slate-400 mt-1">
                        Gunakan akun Google terdaftar untuk masuk
                    </p>
                </div>
                
                <a href="/auth/google" 
                   class="w-full group flex justify-center items-center px-5 py-3.5 border border-slate-700/80 rounded-xl text-sm font-semibold text-white bg-slate-800/80 hover:bg-slate-700/80 hover:border-cyan-500/50 transition-all duration-200 shadow-md">
                    <svg class="w-5 h-5 mr-3 transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                        <path fill="#EA4335" d="M12 5c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    </svg>
                    <span>Masuk dengan Google</span>
                </a>

                <div class="pt-4 border-t border-slate-800">
                    <p class="text-xs text-slate-500">
                        Pesantren Daarul Uluum Lido &copy; 2026
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

